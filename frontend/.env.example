# Rabbly Frontend Environment Configuration
# Default: connects to Render backend service (https://rabbly.onrender.com)
VITE_API_URL=https://rabbly.onrender.com
VITE_WS_URL=wss://rabbly.onrender.com

# Optional: Set to 'true' if you want localhost frontend to target local FastAPI backend on port 8000
# VITE_USE_LOCAL_BACKEND=true
